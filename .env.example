# Read by docker-compose.yml only (via ${VAR} interpolation) — NOT read by
# either app directly. Copy to .env in this same directory.
#
# NEXT_PUBLIC_API_URL is baked into the frontend image at BUILD time (see
# frontend/Dockerfile) — it must be a URL your browser can reach:
#   - local docker-compose:  http://localhost:5000/api  (published port)
#   - real deployment:       https://api.your-real-domain.com/api
# It is NOT the internal "backend" service hostname — the browser can't
# resolve that, only containers on the compose network can.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Host port mappings — change if 5000/3000 are already taken locally.
BACKEND_PORT=5000
FRONTEND_PORT=3000
